---
import Base from '../layouts/base.astro';
import SiteHeader from '../components/site-header.astro';
import SiteFooter from '../components/site-footer.astro';
---

<Base title="Page not found · Avinash Sahu" noindex>
  <SiteHeader />
  <main class="wrap missing">
    <h1>There's nothing at this address.</h1>
    <p>
      The page may have moved when I rebuilt the site. Everything that was here is on
      <a href="/">the homepage</a>.
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  .missing {
    min-height: 60vh;
    padding-block: 5rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.25rem);
  }

  p {
    max-width: var(--measure);
    margin: 0;
  }
</style>
