---
import GraphIsland from './graph/graph-island';
import { createGraphView, projectForSvg, SVG_SIZE } from '../lib/graph-view';

const graph = createGraphView();
const { lines, order } = projectForSvg(graph);
const half = SVG_SIZE / 2;
---

<div class="graph">
  <svg
    class="graph-drawing"
    viewBox={`${-half} ${-half} ${SVG_SIZE} ${SVG_SIZE}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="A graph of my projects and the technologies each one uses"
  >
    <g class="edges">
      {lines.map(({ a, b }) => (
        <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
      ))}
    </g>
    {order.map((n) => (
      <circle class:list={['node', n.kind]} cx={n.x} cy={n.y} r={n.r} />
    ))}
    {order
      .filter((n) => n.kind === 'project')
      .map((n) => (
        <text x={n.labelX} y={n.y + 9} text-anchor="middle" dominant-baseline="hanging">
          {n.label}
        </text>
      ))}
  </svg>
  <div class="graph-live">
    <GraphIsland client:visible {...graph} />
  </div>
</div>

<style>
  .graph {
    position: relative;
    height: 500px;
  }

  .graph-drawing,
  .graph-live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .graph-drawing {
    overflow: visible;
  }

  .graph[data-live] .graph-drawing {
    visibility: hidden;
  }

  .edges line {
    stroke: var(--edge);
    stroke-opacity: 0.2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .node.project {
    fill: var(--ink);
  }

  .node.tech {
    fill: var(--node-tech);
  }

  text {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  @media (max-width: 47.99rem) {
    .graph {
      height: 340px;
      /* The drawing is wider than it is tall, so its square has empty space above. */
      margin-top: -1.5rem;
    }

    /* The drawing scales down with the box, so its labels need to start larger. */
    text {
      font-size: 16px;
    }
  }
</style>

<style is:global>
  /* The live scene renders outside this component's scope, so these are global. */
  .graph-gate {
    position: absolute;
    inset: 0;
  }

  .graph-scene {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .graph-scene[data-ready='true'] {
    opacity: 1;
  }

  .graph-scene[data-pointer='link'] canvas {
    cursor: pointer;
  }

  /* Let a vertical swipe scroll the page; only a horizontal drag rotates. */
  .graph-scene,
  .graph-scene > div,
  .graph-scene canvas {
    touch-action: pan-y !important;
  }

  .graph-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .graph-label {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.2;
    color: var(--ink);
    text-shadow:
      0 0 2px var(--paper),
      0 0 2px var(--paper),
      0 0 3px var(--paper);
    user-select: none;
  }

  .graph-label[data-kind='tech'] {
    display: none;
    color: var(--muted);
  }

  .graph-label[data-kind='tech'][data-state='lit'] {
    display: block;
  }

  .graph-label[data-state='lit'] {
    color: var(--accent);
  }

  .graph-label[data-state='dim'] {
    opacity: 0.3;
  }
</style>
