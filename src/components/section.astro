---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="wrap section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: 3rem;
    padding-block: 3.5rem;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .body > :global(*) {
    max-width: var(--measure);
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .body > :global(:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 47.99rem) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      padding-block: 2.5rem;
    }
  }
</style>
