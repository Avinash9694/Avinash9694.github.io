---
import Section from './section.astro';
import { projects, workAnchor, type Project } from '../data/graph';
import { site } from '../data/site';

const featured = projects.filter((p) => p.tier === 'featured');
const listed = projects.filter((p) => p.tier === 'listed');
const older = projects.filter((p) => p.tier === 'older');

const joinPhrases = (items: Project[]) =>
  items.map((p, i) => ({
    project: p,
    before: i === 0 ? '' : i === items.length - 1 ? ' and ' : ', ',
  }));
---

<Section id="work" title="Work">
  <p class="lead">Some things I've built, mostly to solve problems I ran into at work.</p>

  {featured.map((p) => (
    <article class="entry featured" id={workAnchor(p)}>
      <h3>
        <a href={p.live}>{p.title}</a>
      </h3>
      <p>{p.summary}</p>
      <p class="links">
        <a href={p.live}>
          Try it<span class="visually-hidden">: {p.title}</span>
        </a>
        <span aria-hidden="true"> · </span>
        <a href={p.code}>
          Code<span class="visually-hidden"> for {p.title}</span>
        </a>
      </p>
      {p.image && (
        <img
          class="shot"
          src={p.image.src}
          alt={p.image.alt}
          width={p.image.width}
          height={p.image.height}
          loading="lazy"
          decoding="async"
        />
      )}
    </article>
  ))}

  <ul class="list" role="list">
    {listed.map((p) => (
      <li class="entry" id={workAnchor(p)}>
        <h3>
          <a href={p.live}>{p.title}</a>
        </h3>
        <p>{p.summary}</p>
        <p class="links">
          <a href={p.live}>
            Try it<span class="visually-hidden">: {p.title}</span>
          </a>
          <span aria-hidden="true"> · </span>
          <a href={p.code}>
            Code<span class="visually-hidden"> for {p.title}</span>
          </a>
        </p>
      </li>
    ))}
  </ul>

  <p class="entry older" id="older-work">
    Older projects, including{' '}
    {joinPhrases(older).map(({ project, before }) => (
      <>
        {before}
        <a href={project.code}>{project.phrase}</a>
      </>
    ))}
    , are on <a href={site.github}>GitHub</a>.
  </p>
</Section>

<style>
  .lead {
    margin: 0 0 2.5rem;
    color: var(--muted);
  }

  .entry {
    /* The graph tints an entry when you click its node; this fades it back out. */
    margin-inline: -0.75rem;
    padding: 0.75rem;
    border-radius: 6px;
    transition: background-color 1.2s ease;
  }

  .entry:global(.is-flashed) {
    background-color: var(--tint);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry {
      transition: none;
    }
  }

  h3 {
    margin: 0 0 0.375rem;
    font-size: 1.3125rem;
    font-weight: 500;
  }

  h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  .entry p {
    margin: 0;
  }

  .entry .links {
    margin-top: 0.375rem;
    color: var(--muted);
  }

  .featured {
    max-width: none;
    margin-bottom: 2.25rem;
  }

  .featured h3 {
    font-size: 1.625rem;
  }

  .featured > p {
    max-width: var(--measure);
  }

  .shot {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .list {
    display: grid;
    gap: 1.25rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .older {
    margin-top: 0;
  }
</style>
