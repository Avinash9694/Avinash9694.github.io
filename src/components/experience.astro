---
import Section from './section.astro';
import { formatMonth, roles } from '../data/experience';
---

<Section id="experience" title="Experience">
  <ol class="roles" role="list">
    {roles.map((role) => (
      <li class="role">
        <h3>
          <span class="company">{role.company}</span>
          <span class="title">
            {role.title}
            {role.note && ` (${role.note})`}
          </span>
          <span class="dates">
            <time datetime={role.start}>{formatMonth(role.start)}</time> –{' '}
            {role.end ? <time datetime={role.end}>{formatMonth(role.end)}</time> : 'present'}
          </span>
        </h3>
        <ul>
          {role.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  <p class="aside">My team placed first overall in a company-wide hackathon at Tessell.</p>
</Section>

<style>
  .roles {
    display: grid;
    gap: 2.25rem;
    margin: 0 0 2.25rem;
    padding: 0;
    list-style: none;
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
    margin: 0 0 0.5rem;
    font-size: 1.3125rem;
  }

  .title,
  .dates {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
  }

  .dates {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  ul {
    margin: 0;
    padding-left: 1.125rem;
  }

  li li {
    margin-bottom: 0.375rem;
    padding-left: 0.25rem;
  }

  li li::marker {
    color: var(--muted);
  }

  .aside {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .dates {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
