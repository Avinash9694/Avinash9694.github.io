---
import { site } from '../data/site';
---

<footer class="wrap site-footer">
  <p>
    © 2026 {site.name} · <a href={site.repo}>Source</a>
  </p>
</footer>

<style>
  .site-footer {
    padding-block: 3rem 3.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }
</style>
