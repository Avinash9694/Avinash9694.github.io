---
import Section from './section.astro';
import { projects, projectAnchor } from '../data/graph';
import { site } from '../data/site';
---

<Section id="projects" title="Projects">
  <p class="lead">Some things I've built, mostly to solve problems I ran into at work.</p>

  <ul class="list" role="list">
    {projects.map((p, i) => (
      <li class="entry" id={projectAnchor(p)}>
        <h3>
          <a href={p.live}>{p.title}</a>
        </h3>
        <p class="summary">{p.summary}</p>
        <p class="links">
          <a href={p.live}>
            Try it<span class="visually-hidden">: {p.title}</span>
          </a>
          <span aria-hidden="true"> · </span>
          <a href={p.code}>
            Code<span class="visually-hidden"> for {p.title}</span>
          </a>
        </p>
        <a class="shot-link" href={p.live} tabindex="-1" aria-hidden="true">
          <img
            class="shot"
            src={p.image.src}
            alt=""
            width={p.image.width}
            height={p.image.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>
        <p class="visually-hidden">Screenshot: {p.image.alt}</p>
      </li>
    ))}
  </ul>

  <p class="more">
    More, including older experiments, on <a href={site.github}>GitHub</a>.
  </p>
</Section>

<style>
  .lead {
    margin: 0 0 2.5rem;
    color: var(--muted);
  }

  .list {
    display: grid;
    gap: 3.5rem;
    max-width: none;
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
  }

  .entry {
    /* The graph tints an entry when you click its node; this fades it back out. */
    margin-inline: -0.75rem;
    padding: 0.75rem;
    border-radius: 6px;
    transition: background-color 1.2s ease;
  }

  .entry:global(.is-flashed) {
    background-color: var(--tint);
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry {
      transition: none;
    }
  }

  h3 {
    margin: 0 0 0.375rem;
    font-size: 1.3125rem;
    font-weight: 500;
  }

  h3 a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  .summary {
    max-width: var(--measure);
    margin: 0;
  }

  .links {
    margin: 0.375rem 0 0;
    color: var(--muted);
  }

  .shot-link {
    display: block;
    margin-top: 1.25rem;
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 750;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--rule);
    background: var(--rule);
  }

  .more {
    margin: 0;
    color: var(--muted);
  }
</style>
