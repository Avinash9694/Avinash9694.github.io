---
import Section from './section.astro';
import { site } from '../data/site';
---

<Section id="contact" title="Contact">
  <p>
    The best way to reach me is email: <a href={`mailto:${site.email}`}>{site.email}</a>. I'm also
    on <a href={site.linkedin}>LinkedIn</a> and <a href={site.github}>GitHub</a>.
  </p>
</Section>

<style>
  p {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
